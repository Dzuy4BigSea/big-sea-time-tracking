# Copy to .env and fill in. Track2 uses PostgreSQL (Supabase).
# Local: use the Supabase Session pooler URL (port 5432).
# Vercel: use the Supabase Transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# NextAuth (Auth.js v5) session-signing secret. REQUIRED in production.
# Generate one: `openssl rand -base64 32`  (or `npx auth secret`)
AUTH_SECRET="replace-with-a-32-byte-base64-secret"
